{
  "name": "g4-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval": "tsx eval/run-eval.ts",
    "db:types": "supabase gen types typescript --linked > lib/supabase/types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@hookform/resolvers": "^7.0.9",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    },
    "onlyBuiltDependencies": [
      "supabase",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
