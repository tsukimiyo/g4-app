# 複製成 .env.local 再填值：cp .env.example .env.local
# .env.local 已在 .gitignore，絕對不要 commit 真正的金鑰。
# 金鑰由 C 統一建立，透過群組私下傳給大家（不要貼在 issue / PR / 聊天室公開頻道）。

# --- Supabase（Project Settings → API Keys）---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key（舊版叫 anon key，兩種都可以）— 會送到瀏覽器，受 RLS 保護
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# secret key（舊版叫 service_role key）— 只能在伺服器端使用，會繞過 RLS
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- 網站網址（邀請連結、Email 連結、OAuth 導回用）---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude API（console.anthropic.com）---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 1 = 不呼叫 LLM，改讀 eval/cache-demo/ 裡預先存好的回應（demo 備案、沒有 key 的組員開發用）
LLM_USE_CACHE=0

# --- 排程（Week 2）：pg_cron 呼叫 /api/cron/tick 時帶的密鑰 ---
CRON_SECRET=change-me

# --- 寄信 / 推播（Week 2 再填）---
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
