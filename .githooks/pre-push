#!/bin/sh
# push 前自動跑 pnpm check（lint + typecheck + test），沒過就取消 push。
# 由 scripts/setup-hooks.mjs 在 pnpm install 時啟用（git config core.hooksPath .githooks）。
# 只改 .md 的 push 會跳過檢查。說明見 CONTRIBUTING.md 2-3。

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
if [ -n "$upstream" ]; then
  changed=$(git diff --name-only "$upstream"...HEAD)
  if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -qvE '\.md$'; then
    echo "[pre-push] 只有 .md 變更，略過檢查"
    exit 0
  fi
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "[pre-push] ✗ 找不到 pnpm，push 已取消。請照 docs/setup.md 1-1 安裝 pnpm 後再 push。"
  exit 1
fi

echo "[pre-push] 執行 pnpm check（約 30 秒）…"
if ! pnpm check; then
  echo ""
  echo "[pre-push] ✗ 檢查沒過，push 已取消。修好之後再 push 一次。"
  exit 1
fi
echo "[pre-push] ✓ 檢查通過"
